{
  "name": "fleet-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/db/seed.ts",
    "db:verify": "tsx --env-file-if-exists=.env.local src/db/verify.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}

# Postgres connection string (use the *pooled* Neon connection string).
# Leave empty in development to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# Required. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Optional.
# PGLITE_DIR=.data/pglite   # location of the embedded fallback database
# ALLOW_PGLITE=true         # allow the PGlite fallback in production (throwaway demos only)
# DEMO_MODE=true            # show demo accounts on the login screen (default: on outside production)
